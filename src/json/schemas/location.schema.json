{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/boardml/core/location.schema.json",
  "title": "Area",
  "type": "object",
  "properties": {
    "links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shape": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "cols": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "rows",
        "cols"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object"
    }
  },
  "additionalProperties": false
}