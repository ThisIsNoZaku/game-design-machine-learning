{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/boardml/core/location.schema.json",
  "title": "Area",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "owner": {"type": "string", "description": "Agent id (for hands, player boards)"},
    "links": {"type": "array", "items": {"type": "string"}},
    "constrains": {"type": "array", "items": {"$ref": "https://example.com/boardml/common/expr.schema.json"}}
  }
}