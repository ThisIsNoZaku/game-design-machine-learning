{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/boardml/core/phaseNode.schema.json",
  "title": "PhaseNode",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "enabledActions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "onEnter": {
      "type": "array",
      "items": {
        "$ref": "https://example.com/boardml/common/effect.schema.json"
      }
    },
    "onExit": {
      "type": "array",
      "items": {
        "$ref": "https://example.com/boardml/common/effect.schema.json"
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "https://example.com/boardml/common/transition.schema.json"
      }
    }
  }
}