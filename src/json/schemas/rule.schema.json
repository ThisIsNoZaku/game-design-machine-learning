{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/boardml/core/rule.schema.json",
  "title": "Rule",
  "type": "object",
  "oneOf": [
    {
      "properties": {
        "description": {
          "type": "string"
        },
        "constrains": {
          "type": "object",
          "oneOf": [
            {
              "required": [
                "entity"
              ],
              "properties": {
                "entity": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 1,
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            {
              "required": [
                "agent"
              ],
              "properties": {
                "agent": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 1,
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            {
              "required": [
                "location"
              ],
              "properties": {
                "location": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 1,
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "https://example.com/boardml/common/expr.schema.json"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "properties": {
        "description": {
          "type": "string"
        },
        "when": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "all"
              ],
              "properties": {
                "all": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "https://example.com/boardml/common/expr.schema.json"
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "any"
              ],
              "properties": {
                "any": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "https://example.com/boardml/common/expr.schema.json"
                  }
                }
              }
            },
            {
              "$ref": "https://example.com/boardml/common/expr.schema.json"
            }
          ]
        },
        "then": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "https://example.com/boardml/common/expr.schema.json"
              }
            },
            {
              "$ref": "https://example.com/boardml/common/expr.schema.json"
            }
          ]
        }
      },
      "required": [
        "when",
        "then"
      ],
      "additionalProperties": false
    }
  ]
}