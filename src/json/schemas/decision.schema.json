{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/boardml/core/decision.schema.json",
  "title": "Decision",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": {"type": "string"},
    "label": {"type": "string"},
    "from": {"type": "string", "description": "Expr returning collection to choose from"},
    "min": {"type": "integer", "minimum": 0},
    "max": {"type": "integer", "minimum": 0},
    "constrains": {"type": "array", "items": {"$ref": "https://example.com/boardml/common/expr.schema.json"}},
    "effects": {"type": "array", "items": {"$ref": "https://example.com/boardml/common/effect.schema.json"}},
    "dependsOn": {"type": "array", "items": {"type" :  "string"}},
    "dice": {"type": "string", "description": "Die id for roll-dice decisions"}
  }
}