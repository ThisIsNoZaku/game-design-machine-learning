{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/boardml/core/decision.schema.json",
  "title": "Decision",
  "type": "object",
  "required": ["id", "kind"],
  "properties": {
    "id": {"$ref": "https://example.com/boardml/common/identifier.schema.json"},
    "label": {"type": "string"},
    "kind": {"type": "string", "enum": [
      "select-entity", "select-area", "select-position", "choose-number",
      "choose-from-set", "yes-no", "order-entities", "assign", "reveal-hidden", "roll-dice"
    ]},
    "from": {"type": "string", "description": "Expr returning collection to choose from"},
    "min": {"type": "integer", "minimum": 0},
    "max": {"type": "integer", "minimum": 0},
    "constraints": {"type": "array", "items": {"$ref": "https://example.com/boardml/common/expr.schema.json"}},
    "effects": {"type": "array", "items": {"$ref": "https://example.com/boardml/common/effect.schema.json"}},
    "dependsOn": {"type": "array", "items": {"$ref": "https://example.com/boardml/common/identifier.schema.json"}},
    "dice": {"type": "string", "description": "Die id for roll-dice decisions"}
  }
}