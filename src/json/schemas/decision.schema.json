{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "src/json/schemas/decision.schema.json",
  "title": "Decision",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "unique identifier"
    },
    "label": {
      "type": "string",
      "description": "display name"
    },
    "from": {
      "type": "string",
      "description": "Expr returning collection of options to choose from"
    },
    "min": {
      "type": "integer",
      "minimum": 0,
      "description": "Minimum number of options to select"

    },
    "max": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum number of options to select"
    },
    "constrains": {
      "type": "array",
      "items": {
        "$ref": "./expression.schema.json"
      },
      "description": "TODO: Manual review - define constrains."
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "./effect.schema.json"
      },
      "description": "TODO: Manual review - define effects."
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "TODO: Manual review - define dependsOn."
    },
    "dice": {
      "type": "string",
      "description": "Die id for roll-dice decisions"
    }
  }
}
