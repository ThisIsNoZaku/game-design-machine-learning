{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/boardml/core/trigger.schema.json",
  "title": "Trigger",
  "type": "object",
  "required": ["when", "effects"],
  "properties": {
    "id": {"$ref": "https://example.com/boardml/common/identifier.schema.json"},
    "when": {"$ref": "https://example.com/boardml/common/expr.schema.json"},
    "effects": {"type": "array", "items": {"$ref": "https://example.com/boardml/common/effect.schema.json"}},
    "limit": {"type": "integer", "description": "Times this trigger can fire per turn/game"}
  }
}