{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/boardml/boardml.schema.json",
  "title": "BoardML Game Spec (Top-Level)",
  "type": "object",
  "required": ["metadata", "parameters", "agents", "areas", "entities", "phases", "actions", "rules"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["id", "version", "name"],
      "properties": {
        "id": {"$ref": "https://example.com/boardml/common/identifier.schema.json"},
        "name": {"type": "string"},
        "version": {"type": "integer", "minimum": 1},
        "description": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {"oneOf": [{"type": "string"}, {"type": "number"}, {"type": "boolean"}]}
    },
    "rng": {"$ref": "https://example.com/boardml/rng/die.schema.json"},
    "agents": {"type": "array", "minItems": 1, "items": {"$ref": "https://example.com/boardml/core/agent.schema.json"}},
    "areas": {"type": "array", "minItems": 1, "items": {"$ref": "https://example.com/boardml/core/area.schema.json"}},
    "entities": {"type": "array", "items": {"$ref": "https://example.com/boardml/core/entity.schema.json"}},
    "phases": {"$ref": "https://example.com/boardml/core/phases.schema.json"},
    "actions": {"type": "array", "minItems": 1, "items": {"$ref": "https://example.com/boardml/core/action.schema.json"}},
    "rules": {"type" : "array", "items" : {"$ref": "https://example.com/boardml/core/rule.schema.json"}}
  }
}