{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "src/json/schemas/game.schema.json",
  "title": "BoardML Game Spec (Top-Level)",
  "type": "object",
  "required": [
    "metadata",
    "agents",
    "locations",
    "phases",
    "actions",
    "rules"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "unique identifier"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "TODO: Manual review - define version."
        },
        "description": {
          "type": "string",
          "description": "TODO: Manual review - define description."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "TODO: Manual review - define tags."
        }
      },
      "description": "TODO: Manual review - define metadata."
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "description": "TODO: Manual review - define parameters."
    },
    "rng": {
      "$ref": "./rng.schema.json",
      "description": "TODO: Manual review - define rng."
    },
    "agents": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1,
              "description": "TODO: Manual review - define min."
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "description": "TODO: Manual review - define max."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "exactly": {
              "type": "integer",
              "minimum": 1,
              "description": "TODO: Manual review - define exactly."
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "TODO: Manual review - define agents."
    },
    "locations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "./location.schema.json"
      },
      "description": "TODO: Manual review - define locations."
    },
    "entityTypes": {
      "type": "array",
      "items": {
        "$ref": "./entity.schema.json"
      },
      "description": "TODO: Manual review - define entityTypes."
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./action.schema.json"
      },
      "description": "TODO: Manual review - define actions."
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "$ref": "./rule.schema.json"
      },
      "description": "TODO: Manual review - define rules."
    }
  }
}
