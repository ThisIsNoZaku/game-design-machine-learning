{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/boardml/core/action.schema.json",
  "title": "Action",
  "type": "object",
  "required": ["id", "actor", "decisions"],
  "properties": {
    "id": {"$ref": "https://example.com/boardml/common/identifier.schema.json"},
    "label": {"type": "string"},
    "actor": {"type": "string", "description": "Agent id or role (e.g., currentPlayer)"},
    "pre": {"type": "array", "items": {"$ref": "https://example.com/boardml/common/expr.schema.json"}},
    "decisions": {"type": "array", "items": {"$ref": "https://example.com/boardml/core/decision.schema.json"}},
    "effects": {"type": "array", "items": {"$ref": "https://example.com/boardml/common/effect.schema.json"}},
    "post": {"type": "array", "items": {"$ref": "https://example.com/boardml/common/expr.schema.json"}},
    "tags": {"type": "array", "items": {"type": "string"}}
  }
}