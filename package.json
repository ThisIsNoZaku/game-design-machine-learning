{
  "name": "game-analysis-engine",
  "version": "1.0.0",
  "description": "Machine learning engine to perform analysis of board game designs.",
  "main": "index.js",
  "scripts": {
    "test": "npx jest",
    "test:watch": "npx jest --watchAll",
    "test:coverage": "npx jest --coverage",
    "build": "npx tsc -p tsconfig.build.json",
    "start": "node dist/cli.js"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "jest": "^30.1.3",
    "jest-expect-message": "^1.1.3",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "class-validator-jsonschema": "^5.1.0",
    "commander": "^14.0.0",
    "scikitjs": "^1.24.0"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/.idea/.*",
      "<rootDir>/.*~$",
      "<rootDir>/test/examples/chess/.*"
    ],
    "watchPathIgnorePatterns": [
      ".*~$",
      "<rootDir>/.*~$",
      ".*\\.swp$",
      ".*\\.tmp$",
      "<rootDir>/examples/.*",
      "<rootDir>/test/examples/chess/.*",
      "<rootDir>/.idea/.*",
      ".*\\\\.idea\\\\.*"
    ]
  }
}
